{
    "version": 1,
    "hooks": {
        "afterFileEdit": [
            {
                "command": "python3 .cursor/hooks/review_loop.py edited"
            }
        ],
        "stop": [
            {
                "command": "python3 .cursor/hooks/review_loop.py stop",
                "timeout": 600,
                "loop_limit": 3
            }
        ]
    }
}